import DecisionProgram

open Cordis
open Cordis.DecisionProgram

def spaces (n : Nat) : String := String.mk (List.replicate n ' ')

def rustTree (fields : Vector String n) (leaf : α → String) (indent : Nat) : Tree α n → String
  | .leaf value => spaces indent ++ leaf value ++ "\n"
  | .branch field yes no =>
    let first := spaces indent ++ "if " ++ fields.get field ++ " {\n" ++
      rustTree fields leaf (indent + 4) yes ++ spaces indent ++ "} else "
    match no with
    | .leaf _ => first ++ "{\n" ++ rustTree fields leaf (indent + 4) no ++ spaces indent ++ "}\n"
    | .branch _ _ _ => first ++ String.mk ((rustTree fields leaf indent no).toList.drop indent)

def rustFunction (name result : String) (fields : Vector String n) (leaf : α → String)
    (program : Certified α n) : String :=
  "#[inline]\npub(super) fn " ++ name ++ "(" ++
  String.intercalate ", " (fields.toArray.toList.map fun field => field ++
    if field == "same" || field == "expected" then ": impl FnOnce() -> bool" else ": bool") ++ ") -> " ++ result ++ " {\n" ++
  rustTree (fields.map fun field => if field == "same" || field == "expected" then field ++ "()" else field) leaf 4 program.tree ++ "}\n\n"

def phaseName : Phase → String
  | .pending => "Pending" | .loading => "Loading" | .active => "Active"
  | .failed => "Failed" | .disposed => "Disposed" | .unloading => "Unloading"

def actionName : Action → String
  | .keep => "Keep" | .idle => "Idle" | .load => "Load" | .unload => "Unload"

def targetName : Target → String
  | .keep => "Keep" | .resolved => "Resolved" | .inactive => "Inactive"

def rust : String :=
  "// Generated by formal/Generate.lean from kernel-checked decision trees.\n" ++
  "// Run python tools/verify_semantics.py --write-generated to regenerate.\n\n" ++
  rustFunction "idle" "FiberState" #v["alive", "failed", "active"] ("FiberState::" ++ phaseName ·) idleProgram ++
  rustFunction "target" "TargetDecision" #v["alive", "failed"] ("TargetDecision::" ++ targetName ·) targetProgram ++
  rustFunction "refresh" "Action" #v["inertia", "suspended", "same", "alive", "empty", "old_inactive", "active"]
    ("Action::" ++ actionName ·) refreshProgram ++
  rustFunction "finish" "Action" #v["loading", "same", "unloading", "effects", "active"]
    ("Action::" ++ actionName ·) finishProgram ++
  rustFunction "settled" "bool" #v["inertia", "queued", "notifying", "suspended"] toString settledProgram ++
  rustFunction "current" "bool" #v["alive", "same"] toString currentProgram ++
  rustFunction "current_epoch" "bool" #v["alive", "same", "expected"] toString currentEpochProgram ++
  rustFunction "cleanup" "bool" #v["running", "cleaning"] toString cleanupProgram

def bit (mask field : Nat) : Bool := mask / 2^field % 2 == 1

def emitCases (name : String) (arity : Nat) (expected : (Nat → Bool) → String) : IO Unit := do
  for mask in List.range (2^arity) do
    IO.println (name ++ "\t" ++ toString mask ++ "\t" ++ expected (bit mask))

/-- Expected results use the independently written baseline reference, not Tree.eval. -/
def vectors : IO Unit := do
  emitCases "idle" 3 (fun b => phaseName (idleRef (b 0) (b 1) (b 2)))
  emitCases "target" 2 (fun b => targetName (targetRef (b 0) (b 1)))
  emitCases "refresh" 7 (fun b => actionName (refreshRef (b 0) (b 1) (b 2) (b 3) (b 4) (b 5) (b 6)))
  emitCases "finish" 5 (fun b => actionName (finishRef (b 0) (b 1) (b 2) (b 3) (b 4)))
  emitCases "settled" 4 (fun b => toString (settledRef (b 0) (b 1) (b 2) (b 3)))
  emitCases "current" 2 (fun b => toString (b 0 && b 1))
  emitCases "current_epoch" 3 (fun b => toString (b 0 && b 1 && b 2))
  emitCases "cleanup" 2 (fun b => toString (!b 0 && !b 1))

def main (args : List String) : IO UInt32 := do
  match args with
  | ["rust"] => IO.print rust; return 0
  | ["vectors"] => vectors; return 0
  | _ => IO.eprintln "usage: lake env lean --run Generate.lean (rust|vectors)"; return 2
